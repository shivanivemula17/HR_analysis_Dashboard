  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='HR Analysis'>
      <style />
      <size maxheight='1169' maxwidth='1754' minheight='1169' minwidth='1754' preset-index='14' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Person.Person+ (Multiple Connections)' name='federated.0ox08631faskx71163btk0cyt8z8' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Year&quot;'>
          <calculation class='tableau' formula='&quot;Year&quot;' />
          <members>
            <member value='&quot;Year&quot;' />
            <member value='&quot;Quarter&quot;' />
            <member value='&quot;Month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0ox08631faskx71163btk0cyt8z8'>
        <column caption='country filter' datatype='string' name='[Calculation_1417226510753955842]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF { FIXED [Name (Person.CountryRegion)] : COUNTD([BusinessEntityID (HumanResources.Employee)]) } &gt; 0&#13;&#10;THEN [Name (Person.CountryRegion)]&#13;&#10;END' />
        </column>
        <column caption='ages' datatype='integer' name='[Calculation_849491482378940431]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[BirthDate],TODAY())' />
        </column>
        <column caption='Hire Date' datatype='date' name='[HireDate]' role='dimension' type='ordinal' />
        <column datatype='string' name='[Name (HumanResources.Department)]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;Facilities and Maintenance&quot;' value='Facilities&amp; Maintenance' />
            <alias key='&quot;Research and Development&quot;' value='R &amp; D' />
            <alias key='&quot;Shipping and Receiving&quot;' value='Shipping &amp; Receiving' />
          </aliases>
        </column>
        <column aggregation='None' caption='ages (bin)' datatype='integer' name='[ages (bin)]' role='dimension' type='ordinal'>
          <calculation class='bin' decimals='0' formula='[Calculation_849491482378940431]' peg='0' size='5' />
        </column>
        <column-instance column='[Calculation_1417226510753955842]' derivation='None' name='[none:Calculation_1417226510753955842:nk]' pivot='key' type='nominal' />
        <column-instance column='[Name (HumanResources.Department)]' derivation='None' name='[none:Name (HumanResources.Department):nk]' pivot='key' type='nominal' />
        <column-instance column='[ages (bin)]' derivation='None' name='[none:ages (bin):ok]' pivot='key' type='ordinal' />
        <column-instance column='[HireDate]' derivation='Year' name='[yr:HireDate:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>
