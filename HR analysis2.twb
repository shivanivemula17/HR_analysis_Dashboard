      <column datatype='integer' name='[BusinessEntityID (HumanResources.EmployeeDepartme)]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[BusinessEntityID (HumanResources.EmployeePayHisto)]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[BusinessEntityID (Person.BusinessEntityAddress)]' role='dimension' type='ordinal' />
      <column caption='Business Entity ID' datatype='integer' name='[BusinessEntityID]' role='dimension' type='ordinal' />
      <column caption='Calculation1' datatype='string' name='[Calculation_1417226510742331393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;|&quot;' />
      </column>
      <column caption='country filter' datatype='string' name='[Calculation_1417226510753955842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Name (Person.CountryRegion)] : COUNTD([BusinessEntityID (HumanResources.Employee)]) } &gt; 0&#13;&#10;THEN [Name (Person.CountryRegion)]&#13;&#10;END' />
      </column>
      <column caption='Round box' datatype='string' name='[Calculation_1583015271326973952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='employment status' datatype='string' name='[Calculation_1583015271342559233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([EndDate]) THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Attrited&quot;&#13;&#10;END' />
      </column>
      <column caption='Average salary' datatype='real' name='[Calculation_1583015271350812675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_849491482297741312])/COUNTD([BusinessEntityID (HumanResources.Employee)])' />
      </column>
      <column caption='donut pie' datatype='integer' name='[Calculation_1583015271361843207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Average Tenure' datatype='integer' name='[Calculation_1583015271369449480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [Calculation_1583015271342559233] = &quot;Attrited&quot; THEN&#13;&#10;        DATEDIFF(&apos;year&apos;, [StartDate], [EndDate])&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Monthly salary' datatype='real' name='[Calculation_849491482297741312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [PayFrequency] = 1 THEN &#13;&#10;    [Rate]&#13;&#10;ELSEIF [PayFrequency] = 2 THEN &#13;&#10;    ([Rate] * 26 / 12)&#13;&#10;END' />
      </column>
      <column caption='pay frequency ' datatype='string' name='[Calculation_849491482301505537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [PayFrequency]=1 then &quot;1&quot;&#13;&#10;ELSEIF [PayFrequency]=2 then &quot;2&quot; end' />
      </column>
      <column caption='Dynamic hire date' datatype='string' name='[Calculation_849491482344280073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Year&quot; THEN STR(YEAR([HireDate]))&#13;&#10;    WHEN &quot;Quarter&quot; THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [HireDate]))&#13;&#10;    WHEN &quot;Month&quot; THEN DATENAME(&apos;month&apos;, [HireDate])  &#13;&#10;END' />
        <aliases>
          <alias key='&quot;April&quot;' value='Apr' />
          <alias key='&quot;December&quot;' value='Dec' />
          <alias key='&quot;February&quot;' value='Feb' />
          <alias key='&quot;January&quot;' value='Jan' />
          <alias key='&quot;June&quot;' value='Jun' />
          <alias key='&quot;March&quot;' value='Mar' />
          <alias key='&quot;November&quot;' value='Nov' />
          <alias key='&quot;September&quot;' value='Sep' />
        </aliases>
      </column>
      <column caption='arrow value' datatype='string' name='[Calculation_849491482357338126]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1) &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; + STR(ROUND(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1))) + &quot;%&quot;&#13;&#10;ELSEIF ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1) &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; + STR(ABS(ROUND(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1)))) + &quot;%&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ages' datatype='integer' name='[Calculation_849491482378940431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[BirthDate],TODAY())' />
      </column>
