    <worksheet name='employee difference'>
      <table>
        <view>
          <datasources>
            <datasource caption='Person.Person+ (Multiple Connections)' name='federated.0ox08631faskx71163btk0cyt8z8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Year&quot;'>
              <calculation class='tableau' formula='&quot;Year&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ox08631faskx71163btk0cyt8z8'>
            <column datatype='integer' name='[BusinessEntityID (HumanResources.Employee)]' role='dimension' type='ordinal' />
            <column caption='arrow value' datatype='string' name='[Calculation_849491482357338126]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1) &gt; 0 THEN&#13;&#10;    &quot;▲ &quot; + STR(ROUND(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1))) + &quot;%&quot;&#13;&#10;ELSEIF ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1) &lt; 0 THEN&#13;&#10;    &quot;▼ &quot; + STR(ABS(ROUND(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])) - LOOKUP(ZN(COUNTD([BusinessEntityID (HumanResources.Employee)])), -1)))) + &quot;%&quot;&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dynamic hire date (copy)' datatype='string' name='[Dynamic hire date (copy)_849491482355109901]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Year&quot; THEN STR(YEAR([HireDate]))&#13;&#10;    WHEN &quot;Quarter&quot; THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [HireDate]))&#13;&#10;    WHEN &quot;Month&quot; THEN DATENAME(&apos;month&apos;, [HireDate])  &#13;&#10;END' />
              <aliases>
                <alias key='&quot;April&quot;' value='Apr' />
                <alias key='&quot;December&quot;' value='Dec' />
                <alias key='&quot;February&quot;' value='Feb' />
                <alias key='&quot;January&quot;' value='Jan' />
                <alias key='&quot;June&quot;' value='Jun' />
                <alias key='&quot;March&quot;' value='Mar' />
                <alias key='&quot;November&quot;' value='Nov' />
                <alias key='&quot;September&quot;' value='Sep' />
              </aliases>
            </column>
            <column caption='Hire Date' datatype='date' name='[HireDate]' role='dimension' type='ordinal' />
            <column-instance column='[Dynamic hire date (copy)_849491482355109901]' derivation='None' name='[none:Dynamic hire date (copy)_849491482355109901:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_849491482357338126]' derivation='User' name='[usr:Calculation_849491482357338126:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ox08631faskx71163btk0cyt8z8].[none:Dynamic hire date (copy)_849491482355109901:nk]' kind='hide'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Dynamic hire date (copy)_849491482355109901:nk]' />
              <groupfilter function='member' level='[none:Dynamic hire date (copy)_849491482355109901:nk]' member='&quot;2013&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0ox08631faskx71163btk0cyt8z8].[usr:Calculation_849491482357338126:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[usr:Calculation_849491482357338126:nk]' member='&quot;▲ 82\%&quot;' />
              <groupfilter function='member' level='[usr:Calculation_849491482357338126:nk]' member='&quot;▲ 83\%&quot;' />
              <groupfilter function='member' level='[usr:Calculation_849491482357338126:nk]' member='&quot;▼ 12\%&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0ox08631faskx71163btk0cyt8z8].[usr:Calculation_849491482357338126:nk]</column>
          </slices>
          <aggregation value='true' />
