            <column datatype='integer' name='[BusinessEntityID (HumanResources.Employee)]' role='dimension' type='ordinal' />
            <column caption='Average salary' datatype='real' name='[Calculation_1583015271350812675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_849491482297741312])/COUNTD([BusinessEntityID (HumanResources.Employee)])' />
            </column>
            <column caption='Monthly salary' datatype='real' name='[Calculation_849491482297741312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [PayFrequency] = 1 THEN &#13;&#10;    [Rate]&#13;&#10;ELSEIF [PayFrequency] = 2 THEN &#13;&#10;    ([Rate] * 26 / 12)&#13;&#10;END' />
            </column>
            <column caption='Pay Frequency' datatype='integer' name='[PayFrequency]' role='measure' type='quantitative' />
            <column datatype='real' name='[Rate]' role='measure' type='quantitative' />
